# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clé maître pour chiffrer/déchiffrer la clé LLM de l'utilisateur (AES-256-GCM)
ENCRYPTION_MASTER_KEY=

# Pour déclencher le workflow GitHub Actions du worker (bouton "Scraper")
GITHUB_PAT=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Cron des relances (voir web/src/app/api/cron/reminders)
CRON_SECRET=
RESEND_API_KEY=
REMINDER_EMAIL_TO=

# Optionnel : ajoute un lien vers l'app dans l'email de relance
NEXT_PUBLIC_APP_URL=
