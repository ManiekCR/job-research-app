# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Master key to encrypt/decrypt the user's LLM key (AES-256-GCM)
ENCRYPTION_MASTER_KEY=

# To trigger the worker's GitHub Actions workflow (the "Scrape" button)
GITHUB_PAT=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Reminders cron (see web/src/app/api/cron/reminders)
CRON_SECRET=
RESEND_API_KEY=
REMINDER_EMAIL_TO=

# Optional: adds a link back to the app in the reminder email
NEXT_PUBLIC_APP_URL=
