# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# UUID of the app's single user (sign-ups are disabled)
APP_USER_ID=

# Same value as the web side (web/.env.local.example) — needed to
# decrypt the LLM key saved by the user
ENCRYPTION_MASTER_KEY=

# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
