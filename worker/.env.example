# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# UUID de l'unique utilisateur de l'app (inscriptions désactivées)
APP_USER_ID=

# Même valeur que côté web (web/.env.local.example) — nécessaire pour
# déchiffrer la clé LLM enregistrée par l'utilisateur
ENCRYPTION_MASTER_KEY=

# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
